datasource db {
  provider = "postgresql"
  // datasource URL moved to prisma.config.ts per Prisma 7+ configuration
  // See https://pris.ly/d/config-datasource
}

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

// Enum de status do usuário para o projeto
enum UserStatus {
  ACTIVE
  INACTIVE
}

// Entidade inicial de usuários
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String @map("password_hash")
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
